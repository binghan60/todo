# Copy this file to .env for local development.
# Do not commit your real API key.
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Atlas
MONGODB_URI=your_mongodb_atlas_connection_string

# Session
JWT_SECRET=a_long_random_string

# LINE Login channel (used for persistent login)
LINE_LOGIN_CHANNEL_ID=your_line_login_channel_id
LINE_LOGIN_CHANNEL_SECRET=your_line_login_channel_secret
LINE_LOGIN_CALLBACK_URL=http://localhost:8787/api/auth/line/callback

# LINE Messaging API channel (same Provider as the Login channel, used for reminder push)
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=your_line_messaging_channel_access_token

# Public site URL for the "打開待辦清單" button in LINE reminders (must be https on phones).
# If omitted, the origin of LINE_LOGIN_CALLBACK_URL is used.
APP_BASE_URL=https://your-app.example.com

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:you@example.com
